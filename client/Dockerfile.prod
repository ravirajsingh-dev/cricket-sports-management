# syntax=docker/dockerfile:1

FROM node:24-alpine AS builder
WORKDIR /tt-client

COPY ./client/package.json ./client/package-lock.json ./
RUN npm ci && npm cache clean --force

COPY ./client .
ARG VITE_APP_SERVER_URL
ENV VITE_APP_SERVER_URL=${VITE_APP_SERVER_URL}
RUN npm run build

# ~5–10MB scratch image instead of nginx:alpine (~50MB+)
FROM joseluisq/static-web-server:2
COPY --from=builder /tt-client/dist /public
COPY ./client/sws.toml /home/sws/config.toml
ENV SERVER_CONFIG_FILE=/home/sws/config.toml
EXPOSE 3000
