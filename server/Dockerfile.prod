# syntax=docker/dockerfile:1

FROM node:24-alpine AS deps
WORKDIR /app
COPY ./server/package.json ./server/package-lock.json ./
RUN npm ci --omit=dev \
  && npm cache clean --force \
  && rm -rf /tmp/*

FROM node:24-alpine AS runner
WORKDIR /app

RUN addgroup -g 1001 -S nodejs \
  && adduser -S nodejs -u 1001 \
  && rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
    /tmp/* \
    /var/cache/apk/*

COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/package.json ./package.json
COPY --chown=nodejs:nodejs ./server/server.js ./server.js
COPY --chown=nodejs:nodejs ./server/bootstrap ./bootstrap
COPY --chown=nodejs:nodejs ./server/config ./config
COPY --chown=nodejs:nodejs ./server/infra ./infra
COPY --chown=nodejs:nodejs ./server/models ./models
COPY --chown=nodejs:nodejs ./server/modules ./modules
COPY --chown=nodejs:nodejs ./server/shared ./shared

USER nodejs
ENV NODE_ENV=production
EXPOSE 5000
CMD ["node", "server.js"]
